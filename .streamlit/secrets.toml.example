# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Cloud -> App settings -> Secrets.
# All optional. Without them the app runs fully offline on SQLite.

# Free LLM: create a key at https://console.groq.com/keys
GROQ_API_KEY = "gsk_..."
# GROQ_MODEL = "llama-3.3-70b-versatile"

# Free persistent Postgres (Neon: https://neon.tech). Without it, data resets when the app restarts.
# DATABASE_URL = "postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"
