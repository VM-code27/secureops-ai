# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Cloud -> App settings -> Secrets.
# All optional - without them the app runs on SQLite with the offline AI engine.

# Free LLM: https://console.groq.com/keys  (model is picked automatically from Groq's live list)
GROQ_API_KEY = "gsk_..."
# GROQ_MODEL = "openai/gpt-oss-120b"     # optional: pin a model instead of "auto"

# Free persistent Postgres (https://neon.tech). Without it data resets when the app restarts.
# DATABASE_URL = "postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"

# Faster NVD lookups (free key: https://nvd.nist.gov/developers/request-an-api-key)
# NVD_API_KEY = "..."

